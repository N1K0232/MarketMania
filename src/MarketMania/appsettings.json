{
    "ConnectionStrings": {
        "SqlConnection": "",
        "AzureStorageConnection": ""
    },
    "AppSettings": {
        "ApplicationName": "",
        "ApplicationDescription": "",
        "CommandTimeout": 120,
        "DefaultSlidingExpiration": "00:00:00",
        "ExecuteStartup": false,
        "MaxRetryCount": 0,
        "MaxRetryDelay": "00:00:00",
        "MaxUploadSize": 0,
        "StorageFolder": "",
        "SupportedCultures": []
    },
    "SwaggerSettings": {
        "IsEnabled": false,
        "UserName": "",
        "Password": ""
    },
    "EmailSettings": {
        "Host": "",
        "Port": 25,
        "UseSsl": false,
        "SenderEmail": "",
        "SenderName": "",
        "UserName": null,
        "Password": null,
        "IgnoreServerCertificateErrors": false
    },
    "Authentication": {
        "DefaultScheme": "",
        "ApiKey": {
            "HeaderName": "x-api-key"
        },
        "JwtBearer": {
            "SchemeName": "",
            "SecurityKey": "",
            "Algorithm": "",
            "Issuers": [],
            "Audiences": [],
            "ExpirationTime": "00:00:00",
            "ClockSkew": "00:00:00",
            "EnableJwtBearerService": false
        }
    },
    "AdministratorUser": {
        "FirstName": "",
        "Email": "",
        "Password": ""
    },
    "PowerUser": {
        "FirstName": "",
        "Email": "",
        "Password": ""
    },
    "PdfSmith": {
        "SubscriptionKey": null
    },
    "SentimentAnalysis": {
        "SubscriptionKey": null
    },
    "Encryption": {
        "KeySize": 0,
        "SaltSize": 0,
        "Iterations": 0,
        "HmacKey": null
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.MSSqlServer" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Information",
                "Microsoft.AspNetCore.Identity": "Error",
                "Microsoft.EntityFrameworkCore": "Error",
                "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Debug"
            },
            {
                "Name": "Console",
                "Args": {
                    "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
                }
            },
            {
                "Name": "MSSqlServer",
                "Args": {
                    "connectionString": "SqlConnection",
                    "sinkOptionsSection": {
                        "tableName": "Logs",
                        "autoCreateSqlTable": true
                    },
                    "restrictedToMinimumLevel": "Information",
                    "columnOptionsSection": {
                        "addStandardColumns": [ "LogEvent", "TraceId", "SpanId" ],
                        "removeStandardColumns": [ "MessageTemplate", "Properties" ],
                        "additionalColumns": [
                            {
                                "ColumnName": "UserName",
                                "PropertyName": "UserName",
                                "DataType": "nvarchar",
                                "DataLength": 255,
                                "AllowNull": true
                            },
                            {
                                "ColumnName": "IsHttp",
                                "PropertyName": "IsHttp",
                                "DataType": "bit",
                                "AllowNull": true
                            },
                            {
                                "ColumnName": "LevelNumber",
                                "PropertyName": "LevelNumber",
                                "DataType": "int",
                                "AllowNull": true
                            }
                        ],
                        "id": { "dataType": "bigint" },
                        "timeStamp": {
                            "columnName": "Timestamp",
                            "convertToUtc": true,
                            "nonClusteredIndex": true,
                            "nonClusteredIndexDirection": "Desc"
                        },
                        "logEvent": {
                            "excludeAdditionalProperties": false,
                            "excludeStandardColumns": false
                        }
                    }
                }
            }
        ],
        "Enrich": [ "FromLogContext" ]
    },
    "AllowedHosts": "*"
}