<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SourceRevisionId>build$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</SourceRevisionId>
    <Company>Nicola Silvestri</Company>
    <Authors>Nicola Silvestri</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.3.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.0" />
    <PackageReference Include="LigerShark.WebOptimizer.Core" Version="3.0.477" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="MinimalHelpers.FluentValidation" Version="1.1.6" />
    <PackageReference Include="MinimalHelpers.OpenApi" Version="2.1.13" />
    <PackageReference Include="MinimalHelpers.Routing" Version="2.1.2" />
    <PackageReference Include="OperationResultTools.AspNetCore.Http" Version="1.0.30" />
    <PackageReference Include="Scrutor" Version="6.1.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.MSSqlServer" Version="9.0.2" />
    <PackageReference Include="SimpleAuthenticationTools" Version="3.1.6" />
    <PackageReference Include="SimpleAuthenticationTools.Swashbuckle" Version="3.1.6" />
    <PackageReference Include="SimpleTransit" Version="1.0.24" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.0.0" />
    <PackageReference Include="TinyHelpers.AspNetCore" Version="4.1.8" />
    <PackageReference Include="TinyHelpers.AspNetCore.Swashbuckle" Version="4.0.30" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="BuildDateTimeAttribute">
        <_Parameter1>$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarketMania.Authentication\MarketMania.Authentication.csproj" />
    <ProjectReference Include="..\MarketMania.BusinessLayer\MarketMania.BusinessLayer.csproj" />
  </ItemGroup>

</Project>
