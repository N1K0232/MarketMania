<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
    <SourceRevisionId>build$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</SourceRevisionId>
    <Company>Nicola Silvestri</Company>
    <Authors>Nicola Silvestri</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
    <PackageReference Include="LigerShark.WebOptimizer.Core" Version="3.0.436" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.7" />
    <PackageReference Include="MinimalHelpers.FluentValidation" Version="1.1.4" />
    <PackageReference Include="MinimalHelpers.OpenApi" Version="2.1.10" />
    <PackageReference Include="MinimalHelpers.Routing" Version="2.1.2" />
    <PackageReference Include="OperationResultTools.AspNetCore.Http" Version="1.0.28" />
    <PackageReference Include="Scrutor" Version="6.1.0" />
    <PackageReference Include="SimpleAuthenticationTools" Version="3.0.13" />
    <PackageReference Include="SimpleAuthenticationTools.Swashbuckle" Version="3.0.22" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.3" />
    <PackageReference Include="TinyHelpers.AspNetCore" Version="4.0.29" />
    <PackageReference Include="TinyHelpers.AspNetCore.Swashbuckle" Version="4.0.24" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="BuildDateTimeAttribute">
        <_Parameter1>$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarketMania.BusinessLayer\MarketMania.BusinessLayer.csproj" />
