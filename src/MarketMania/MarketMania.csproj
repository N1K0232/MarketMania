    <PackageReference Include="MinimalHelpers.FluentValidation" Version="1.1.4" />
    <PackageReference Include="MinimalHelpers.OpenApi" Version="2.1.12" />
    <PackageReference Include="MinimalHelpers.Routing" Version="2.1.2" />
    <PackageReference Include="OperationResultTools.AspNetCore.Http" Version="1.0.28" />
    <PackageReference Include="Scrutor" Version="6.1.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="SimpleAuthenticationTools" Version="3.0.15" />
    <PackageReference Include="SimpleAuthenticationTools.Swashbuckle" Version="3.0.23" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
    <PackageReference Include="TinyHelpers.AspNetCore" Version="4.1.6" />
    <PackageReference Include="TinyHelpers.AspNetCore.Swashbuckle" Version="4.0.26" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="BuildDateTimeAttribute">
        <_Parameter1>$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</_Parameter1>
